{
  "expo": {
    "name": "Dayframe",
    "slug": "dayframe-routine-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.dayframe"
    },
    "android": {
      "package": "com.example.dayframe",
      "adaptiveIcon": {
        "backgroundColor": "#E7EDE6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "routine-reminders",
          "sounds": []
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
